<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_imex_inventory" model="ir.actions.report">
        <field name="name">Inventory In/Out Summary</field>
        <field name="model">imex.inventory.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mj_inventory_report.imex_inventory_report_pdf</field>
        <field name="binding_model_id" ref="model_imex_inventory_report"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Inventory In-Out Summary'</field>
    </record>

    <template id="imex_inventory_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Inventory In/Out Summary</h2>

                    <p t-if="docs and docs[0].date_from">
                        Period:
                        <span t-field="docs[0].date_from"/> &#8594;
                        <span t-field="docs[0].date_to"/>
                    </p>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>UoM</th>
                                <th>Category</th>
                                <th>Location</th>
                                <th class="text-end">Opening</th>
                                <th class="text-end">In</th>
                                <th class="text-end">Out</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="line">
                                <tr>
                                    <td><t t-out="line.product_id.display_name"/></td>
                                    <td><t t-out="line.product_uom.name"/></td>
                                    <td><t t-out="line.product_category.display_name"/></td>
                                    <td><t t-out="line.location.display_name"/></td>
                                    <td class="text-end"><span t-field="line.initial"/></td>
                                    <td class="text-end"><span t-field="line.product_in"/></td>
                                    <td class="text-end"><span t-field="line.product_out"/></td>
                                    <td class="text-end"><span t-field="line.balance"/></td>
                                    <td class="text-end"><span t-field="line.total_value"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

</odoo>
